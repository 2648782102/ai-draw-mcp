{
  "name": "ai-draw-mcp",
  "version": "0.3.1",
  "description": "Human ↔ AI visual collaboration workspace for MCP: scan a project, edit the diagram, discuss intent, and apply approved code changes.",
  "type": "module",
  "bin": {
    "ai-draw-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2648782102/ai-draw-mcp.git"
  },
  "homepage": "https://github.com/2648782102/ai-draw-mcp#readme",
  "bugs": {
    "url": "https://github.com/2648782102/ai-draw-mcp/issues"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"const fs=require('fs'),p=require('path');const s=p.join('src','infra','templates'),d=p.join('dist','infra','templates');fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:mcp": "vitest run test/mcp.test.mjs",
    "test:examples": "node --check examples/node-client.mjs && node --check examples/collab-demo.mjs && node --check examples/agent-workflow.mjs",
    "test:examples:workflow": "node examples/agent-workflow.mjs",
    "check": "npm run lint && npm run build && npm test && npm run test:examples && npm run test:examples:workflow && npm run docs:assets:check && npm run repo:check && npm run doctor && npm pack --dry-run",
    "doctor": "node scripts/doctor.mjs",
    "github:check": "node scripts/github-maintenance.mjs --check",
    "github:sync": "node scripts/github-maintenance.mjs",
    "docs:assets": "node scripts/generate-doc-assets.mjs",
    "docs:assets:check": "node scripts/generate-doc-assets.mjs --check",
    "repo:check": "node scripts/repo-check.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai",
    "drawing",
    "diagram",
    "mermaid",
    "flowchart",
    "cursor",
    "vscode",
    "windsurf",
    "trae",
    "claude",
    "llm",
    "human-in-the-loop",
    "visualization",
    "local-first"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "mermaid": "^11.6.0",
    "@mermaid-js/mermaid-cli": "^11.4.0",
    "sharp": "^0.33.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "nanoid": "^5.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
